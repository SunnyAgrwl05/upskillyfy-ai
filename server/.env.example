PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/upskillyfy
JWT_SECRET=replace_with_a_long_random_secret
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Upskillyfy <your_email@example.com>
EMAIL_SERVICE=gmail
# Use EMAIL_HOST/EMAIL_PORT/EMAIL_SECURE for a custom SMTP provider instead of EMAIL_SERVICE.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
GOOGLE_CLIENT_ID=
# Optional resume analysis providers. Set one or both; OpenRouter is tried first.
# Never put provider keys in client/.env or frontend source.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_MS=45000
# Optional private Cloudflare R2 storage for resume and hackathon attachments.
# Create an R2 API token scoped to this bucket only.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
CLIENT_URL=http://localhost:5173

# Optional LaTeX compiler image
# LATEX_COMPILER_IMAGE=your-registry/tectonic-bundle@sha256:...
