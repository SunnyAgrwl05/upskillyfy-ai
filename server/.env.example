PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/upskillyfy
JWT_SECRET=replace_with_a_long_random_secret
EMAIL_USER=upskillyfy@gmail.com
EMAIL_PASS=your_gmail_app_password
CLIENT_URL=http://localhost:5173
# Comma-separated production and additional trusted frontend origins
EXTRA_CORS_ORIGINS=https://www.upskillyfy-ai.tech,https://upskillyfy-ai.tech
# Google OAuth Web Client ID (same value used by the frontend)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
# Optional private S3-compatible bucket used for resume PDFs, hackathon submissions, and certificates.
# Set R2_ACCOUNT_ID (recommended) or the account-specific R2_ENDPOINT.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
SERVER_URL=http://localhost:5000
COURSE_API_BASE_URL=http://localhost:3000
COURSE_API_KEY=replace_with_course_api_key
# Docker image used by the authenticated Tectonic compiler route.
# Build it with: docker build -t upskillyfy-tectonic:0.17 ./server/latex-compiler
LATEX_COMPILER_IMAGE=upskillyfy-tectonic:0.17
CHROME_EXECUTABLE_PATH=
CERTIFICATE_ISSUER_NAME=Upskillyfy AI
CERTIFICATE_ISSUER_TITLE=Authorized Issuer
CERTIFICATE_LOGO_PATH=
CERTIFICATE_SIGNATURE_PATH=
# AI Resume Analyzer providers (server only; fallback order: Gemini, Gemini Lite, Groq, OpenRouter, OpenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BACKUP_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Preferred free-tier AI provider for resume analysis (create a key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
